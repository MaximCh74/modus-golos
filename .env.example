# Скопировать в .env. Секреты только здесь, файл в .gitignore.

# Подпись сессий; пусто — генерируется один раз в var/secret
MF_SECRET=

# Внешний адрес для QR-кодов и трекинг-ссылок (туннель или домен), без слэша в конце.
# Пусто — берётся адрес текущего запроса.
MF_PUBLIC_URL=

# Папка с базой и вложениями (в Docker всегда /data)
# MF_DATA_DIR=./var

# ИИ (этап 2). Без ключа: разбор совещания — заскриптованный демо-разбор (плашка «Демо-разбор без ИИ»),
# категория обращения — словарь ключевых слов. Ключ кладёт владелец, в чат и в git не попадает.
OPENAI_API_KEY=
MF_LLM_MODEL=gpt-4o-mini
MF_LLM_TIMEOUT=60

# STT: faster-whisper (локально на GPU, по умолчанию) | openai (whisper-1) | off (только текстовая расшифровка)
MF_STT=faster-whisper
# Модель выбрана тестом tools/stt_bench.py 11.11.2026 (docs/STATUS.md): large-v3-turbo лучше medium на казахском и быстрее
MF_WHISPER_MODEL=large-v3-turbo
MF_WHISPER_COMPUTE=int8_float16
MF_WHISPER_DEVICE=auto
# Язык расшифровки: пусто — автоопределение (ru/kk), иначе ru или kk
MF_STT_LANGUAGE=
# Прогрев модели при старте сервера (1/0)
MF_STT_WARMUP=1

# Битрикс24 (этап 6 §1). Пусто — интеграция выключена: кнопок «Войти через Битрикс24» нет, уведомления не дублируются.
# Адрес тестового или боевого портала без https://, например modus-test.bitrix24.kz
BITRIX_PORTAL=
# Код и ключ локального приложения («Разработчикам» → «Другое» → «Локальное приложение»); ключ показывается один раз после сохранения
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
# member_id портала (необязательно): без него запоминается при первой проверенной установке; запросы с другим member_id — отказ
BITRIX_MEMBER_ID=
# Быстрый старт без приложения: входящий вебхук со скоупом im (только уведомления), например https://modus-test.bitrix24.kz/rest/1/abcdef/
BITRIX_WEBHOOK_URL=
# Поручения с совещаний → задачи Битрикса (скоуп task): 1/0
BITRIX_TASKS=0
